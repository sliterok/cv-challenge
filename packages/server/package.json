{
  "name": "@cv-challenge/server",
  "version": "1.0.0",
  "description": "Server-side engine and Express adapter for the CV Challenge interactive verification flow.",
  "keywords": [
    "verification",
    "challenge",
    "express",
    "opencv"
  ],
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "opencv4nodejs": {
    "disableAutoBuild": 1
  },
  "dependencies": {
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "jose": "^5.9.3",
    "opencv4nodejs": "^5.6.0",
    "simplex-noise": "^4.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/fluent-ffmpeg": "^2.1.25",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
